# Copy this file to .env and fill it in. Never commit .env.
# Lines starting with # are comments. Leave optional values empty to use the default.

# ---------- Telegram login (required) ----------
# Identifies your app to Telegram. Get both at https://my.telegram.org
# -> "API development tools". They are tied to your account, so keep them private.
TG_API_ID=
TG_API_HASH=

# ---------- What to watch (required) ----------
# The group(s) to read, comma-separated. Accepts a @username, a t.me link,
# a numeric id, or part of the group's title as shown in your chat list.
# You must already be a member of the group.
TG_GROUP=job seeker

# Optional. For groups that have topics (forum-style): read only these topics.
# Comma-separated titles or numeric ids. Empty = read every topic.
TG_TOPICS=

# ---------- LLM (required) ----------
# Key for OpenRouter, which the bot calls to score each post.
# Create one at https://openrouter.ai/keys. Set a spending limit on it.
OPENROUTER_API_KEY=

# Which model scores the posts. Any slug from https://openrouter.ai/models.
# Pick one with image input support if you want photo-only posts read.
LLM_MODEL=anthropic/claude-haiku-5-5

# ---------- Where matches go (optional) ----------
# Empty = matches arrive in your own "Saved Messages".
# For real push notifications, use your own bot instead:
#   1. Message @BotFather, create a bot, and copy its token here.
#   2. Open your new bot in Telegram and press Start.
#   3. Message @userinfobot to find your numeric chat id and put it below.
NOTIFY_BOT_TOKEN=
NOTIFY_CHAT_ID=

# ---------- Tuning ----------
# Only posts scoring at least this (0-100) are sent to you.
# Raise it for fewer, better matches. Lower it for more.
MIN_SCORE=70

# Posts with less text than this many characters are skipped,
# unless they carry a photo (then the photo is read instead).
MIN_MESSAGE_LENGTH=60

# Optional. Comma-separated words; any post containing one is dropped before the LLM
# is called (free and exact). Case-insensitive. Example: EXCLUDE_KEYWORDS=msbu,acme staffing
EXCLUDE_KEYWORDS=

# On start, also scan this many past hours so you don't miss posts while the bot was off.
# Set it higher than your longest expected downtime.
BACKFILL_HOURS=12

# ---------- Advanced (usually leave unset) ----------
# Name of the Telegram login file the bot creates. It is a full login to your account.
# TG_SESSION=jobbot_session
# Where the bot remembers which posts it already handled.
# DB_PATH=seen.db
# Which profile file to score against.
# PROFILE_PATH=profile.md
